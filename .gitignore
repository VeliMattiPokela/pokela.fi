# Alkuperäinen design-paketti: brändiohje, casejen lähdedokumentit ja
# asiakaskaappaukset. 31 MB lähdemateriaalia jota koodi ei käytä —
# tsconfig jättää sen jo ulos. Repon argumentti on koodi ja
# synkkatarkistus, ei lähdepaketti.
portfolio-pokela/

# Local Netlify folder
.netlify

# Kuvaputki. Postilaatikko on työpöytä, ei arkisto; johdannaiset
# lasketaan buildissa lähteistä (kuvat/). Molemmat syntyvät
# komennolla `npm run kuvat`.
kuvat/uudet/
public/kuva/

# npm-paketit. Kokonaan johdettuja — myös niiden package.json. Versio
# tulee tokens.jsonin $meta.versionista. Syntyvät komennolla
# `npm run paketti`. Johdannaisia ei säilytetä versionhallinnassa.
packages/

# Tyylivedos: lasketut tyylit ennen ja jälkeen muutoksen. Työkalu yhtä
# refaktorointia varten, ei tarkistus eikä osa ketjua.
.tyylivedos/

# Buildin kirjaamat vaiheet (scripts/ajo.mjs). Syntyy joka buildissa,
# ja case 03 näyttää ne.
.ajo/
