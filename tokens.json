{
  "$meta": {
    "name": "Pokela Portfolio",
    "version": "1.1.0",
    "direction": "1f / 1g — editorial grotesk layout with didone display",
    "defaultTheme": "system (light-dark), override via data-theme",
    "source": "styles/tokens.css — tämä tiedosto on sen koneluettava peili. scripts/check-tokens.mjs valvoo vastaavuutta."
  },
  "color": {
    "light": {
      "paper": "#FFFFFF",
      "paper-alt": "#FAFAF8",
      "line": "#E8E8E6",
      "line-strong": "#101112",
      "ink": "#101112",
      "ink-muted": "#45464A",
      "ink-faint": "#6A6C6E",
      "badge-surface": "#EDEDEA",
      "invert-surface": "#101112",
      "invert-ink": "#F4F4F2",
      "invert-faint": "#B6B8BA",
      "placeholder-base": "#EFEFEC",
      "placeholder-stripe": "#E7E7E3",
      "code-surface": "#101112",
      "code-ink": "#F4F4F2",
      "code-muted": "#A8ABAD",
      "code-faint": "#8A8D90"
    },
    "dark": {
      "paper": "#0E0F10",
      "paper-alt": "#16181A",
      "line": "#262829",
      "line-strong": "#F4F4F2",
      "ink": "#F4F4F2",
      "ink-muted": "#B9BCBF",
      "ink-faint": "#9A9DA1",
      "badge-surface": "#232527",
      "invert-surface": "#F4F4F2",
      "invert-ink": "#0E0F10",
      "invert-faint": "#4A4C4E",
      "placeholder-base": "#1B1D1F",
      "placeholder-stripe": "#16181A",
      "code-surface": "#1B1D1F",
      "code-ink": "#F4F4F2",
      "code-muted": "#A8ABAD",
      "code-faint": "#8A8D90"
    }
  },
  "font": {
    "display": "var(--font-bodoni, 'Bodoni Moda'), Georgia, serif",
    "ui": "var(--font-archivo, 'Archivo'), Helvetica, Arial, sans-serif",
    "$note": "Fallback on var():n sisällä — muuten puuttuva next/font-muuttuja tekisi koko määrittelystä epäkelvon.",
    "code": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "typeNote": "size/lineHeight ovat lg-arvoja (≥1200px). Pienemmät koot ovat kohdassa typeScale.",
  "type": {
    "display-xl": {
      "size": "136px",
      "lineHeight": "0.88",
      "tracking": "-0.02em",
      "weight": 400,
      "font": "display",
      "note": "wordmark / etusivun nimi"
    },
    "display-l": {
      "size": "82px",
      "lineHeight": "0.96",
      "tracking": "-0.005em",
      "weight": 400,
      "font": "display",
      "note": "footer-CTA, casesivun otsikko"
    },
    "display-m": {
      "size": "46px",
      "lineHeight": "1.12",
      "tracking": "-0.005em",
      "weight": 400,
      "font": "display",
      "note": "väitelause, osion otsikko"
    },
    "display-s": {
      "size": "38px",
      "lineHeight": "1",
      "tracking": "-0.005em",
      "weight": 400,
      "font": "display",
      "note": "indeksirivin työn nimi"
    },
    "body-l": {
      "size": "17px",
      "lineHeight": "1.65",
      "weight": 400,
      "font": "ui"
    },
    "body": {
      "size": "16px",
      "lineHeight": "1.65",
      "weight": 400,
      "font": "ui"
    },
    "body-s": {
      "size": "14px",
      "lineHeight": "1.6",
      "weight": 400,
      "font": "ui"
    },
    "meta": {
      "size": "11px",
      "lineHeight": "1.4",
      "tracking": "0.16em",
      "weight": 600,
      "transform": "uppercase",
      "font": "ui"
    },
    "meta-s": {
      "size": "10px",
      "lineHeight": "1.4",
      "tracking": "0.2em",
      "weight": 600,
      "transform": "uppercase",
      "font": "ui"
    },
    "code": {
      "size": "13px",
      "lineHeight": "1.5",
      "weight": 400,
      "font": "code",
      "note": "koodilohko ja inline-koodi"
    }
  },
  "weight": {
    "400": 400,
    "500": 500,
    "600": 600
  },
  "weightNote": "Nimi = arvo. Vain ladatut leikkaukset: Archivo 400/500/600, Bodoni 400/500.",
  "typeScale": {
    "display-xl": {
      "base": "52px",
      "sm": "76px",
      "md": "104px",
      "lg": "136px"
    },
    "display-l": {
      "base": "40px",
      "sm": "52px",
      "md": "64px",
      "lg": "82px"
    },
    "display-m": {
      "base": "28px",
      "sm": "34px",
      "md": "40px",
      "lg": "46px"
    },
    "display-s": {
      "base": "26px",
      "sm": "30px",
      "md": "34px",
      "lg": "38px"
    }
  },
  "space": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "40": "40px",
    "44": "44px",
    "48": "48px",
    "56": "56px",
    "72": "72px",
    "96": "96px",
    "128": "128px"
  },
  "spaceNote": "Nimetty arvon mukaan: --space-24 on 24px. 32/40/48 lisättiin v1.1:ssä koska sivupohjat käyttivät niitä skaalan ulkopuolelta.",
  "layout": {
    "strategy": "mobile-first",
    "maxWidth": "1440px",
    "breakpoints": {
      "base": "0",
      "sm": "600px",
      "md": "900px",
      "lg": "1200px"
    },
    "pagePadding": {
      "base": "20px",
      "sm": "24px",
      "md": "28px",
      "lg": "36px"
    },
    "columns": {
      "base": 4,
      "sm": 8,
      "md": 12,
      "lg": 12
    },
    "gutter": {
      "base": "16px",
      "sm": "20px",
      "md": "24px",
      "lg": "24px"
    },
    "sectionGap": {
      "base": "48px",
      "sm": "64px",
      "md": "80px",
      "lg": "96px"
    },
    "tapMin": "44px",
    "measure": "62ch"
  },
  "border": {
    "hairline": "1px",
    "hairlineStrong": "2px",
    "radius": "0px",
    "focusWidth": "2px",
    "focusOffset": "2px"
  },
  "icon": {
    "s": "12px",
    "m": "16px",
    "l": "24px"
  },
  "measureNote": "Lukumittoja on yksi: measure (62ch). Se riittää myös 14 pikselin tekstille, koska ch skaalautuu fonttikoon mukana — sama luku tarkoittaa suunnilleen samaa merkkimäärää joka koossa. Kaikki muut ch-arvot sivustolla olivat taittovarmistuksia eivätkä lukumittoja, ja ne on kirjoitettu pikseleiksi. Harvennettuun metatekstiin ch ei sovi lainkaan: se ei tunne letter-spacingia, joten 68ch lupasi 68 merkkiä mutta riville mahtui 35.",
  "iconNote": "Ikonit piirretään 16×16-ruudukolle ja skaalataan näihin kolmeen kokoon. Viivanpaksuus ei ole oma tokeninsa vaan border.hairline — ikoni on piirretty samalla viivalla kuin jokainen reuna. Kaaria ei ole (border.radius on 0), joten päätteet ovat tylpÃ¤t ja kulmat terävät.",
  "ratio": {
    "hero": {
      "base": "4/5",
      "sm": "16/9",
      "md": "21/9"
    },
    "case": "4/3",
    "card": "4/5",
    "portrait": "3/4",
    "square": "1/1"
  },
  "motion": {
    "duration": {
      "fast": "180ms",
      "base": "220ms",
      "slow": "320ms",
      "reveal": "600ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "reveal": {
      "translate": "12px",
      "stagger": "70ms"
    }
  },
  "lineHeightScale": {
    "display-xl": {
      "base": "0.92",
      "sm": "0.92",
      "md": "0.92",
      "lg": "0.88"
    },
    "display-l": {
      "base": "1",
      "sm": "1",
      "md": "1",
      "lg": "0.96"
    },
    "display-m": {
      "base": "1.12",
      "sm": "1.12",
      "md": "1.12",
      "lg": "1.12"
    },
    "display-s": {
      "base": "1",
      "sm": "1",
      "md": "1",
      "lg": "1"
    }
  },
  "lineHeightNote": "Rivivälit breakpointeittain. Vain xl ja l muuttuvat (lg-tasolla tiukempi)."
}
